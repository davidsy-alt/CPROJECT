---
/**
 * Bandeau « Faites le choix de l'expertise CPROJECT' » : arguments, labels et bouton de contact.
 * Reprend l'encart présent sur chaque page prestation du site d'origine.
 */
import { Image } from 'astro:assets';
import { lien } from '../data/liens';
import { qcmQuestions } from '../data/qcm';
import { partenaires, type PartenaireId } from '../data/photos';
import Icon from './Icon.astro';

interface Props {
  /** Arguments affichés sous le titre. */
  items: string[];
  /** Logos de labels à afficher. */
  certifications?: PartenaireId[];
  /** Réponse pré-cochée à la question « travaux » du formulaire (pages prestations). */
  presetTravaux?: number;
}

const { items, certifications = [], presetTravaux } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-stone-950 text-white">
  <div class="texture-dark absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-page grid items-center gap-12 py-16 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-7">
      <p class="eyebrow text-(--accent-light)">Contactez-nous</p>
      <h2 class="mt-4 text-5xl leading-[0.95] font-bold tracking-tight text-balance uppercase italic sm:text-6xl">
        Faites le choix de l’expertise
        <span class="whitespace-nowrap"><span class="text-(--accent-light)">C</span>PROJECT’</span>
      </h2>
      <ul class="mt-8 grid gap-x-8 gap-y-3 text-lg font-medium text-stone-100 sm:grid-cols-2">
        {
          items.map((item) => (
            <li class="flex items-center gap-3">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-(--accent-light) text-stone-950">
                <Icon name="check" class="size-4" />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
      {
        certifications.length > 0 && (
          <ul class="mt-9 flex flex-wrap gap-3">
            {certifications.map((id) => (
              <li class="flex h-20 w-28 items-center justify-center rounded-xl bg-white p-2.5">
                <Image
                  src={partenaires[id].logo}
                  alt={partenaires[id].name}
                  width={160}
                  class="max-h-full w-auto object-contain"
                />
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="lg:col-span-5">
      <div class="rounded-3xl bg-white p-7 text-stone-800 shadow-lift sm:p-9">
        <p class="font-display text-3xl leading-none font-bold tracking-tight text-stone-950 sm:text-4xl">
          Votre projet en {qcmQuestions.length} questions
        </p>
        <p class="mt-3 text-stone-600">
          Répondez à un court questionnaire, laissez vos coordonnées : nous vous rappelons sur le créneau de votre choix.
        </p>
        <a
          href={lien('/contact/#formulaire')}
          data-open-contact
          data-preset-question={presetTravaux !== undefined ? 'travaux' : undefined}
          data-preset-option={presetTravaux}
          class="btn btn-primary btn-lg mt-6 w-full"
        >
          Demander un devis gratuit <Icon name="arrow-right" />
        </a>
        <p class="mt-5 flex items-center justify-center gap-2 text-sm text-stone-500">
          <Icon name="clock" class="size-4" /> Moins d’une minute
        </p>
      </div>
    </div>
  </div>
</section>

---
import { lien } from '../data/liens';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { departements, site } from '../data/site';
import { photo } from '../data/photos';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Coordonnees from '../components/Coordonnees.astro';
import ContactDialog from '../components/ContactDialog.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  /** Affiche la carte Google Maps dans le bloc « Nos coordonnées » en bas de page. */
  map?: boolean;
  /** La page contient déjà le formulaire : les boutons « Contact » y mènent au lieu d'ouvrir la fenêtre. */
  inlineContactForm?: boolean;
  /** Ajoute noindex (pages utilitaires comme les mentions légales). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  map = false,
  inlineContactForm = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Aperçu en ligne du prototype (npm run apercu) : aucune page ne doit être référencée par les
// moteurs de recherche, pour ne pas concurrencer le vrai site.
const apercu = import.meta.env.PUBLIC_SITE_PREVIEW === 'true';
const shareImage = await getImage({ src: photo('platre-projete-4'), width: 1200, format: 'jpg' });

// Données structurées : entreprise locale du bâtiment (référencement local).
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  description: site.description,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: 'Grand Est',
    addressCountry: 'FR',
  },
  areaServed: departements.map((departement) => ({ '@type': 'AdministrativeArea', name: departement.name })),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={lien('/favicon.ico')} />
    <link rel="sitemap" href={lien('/sitemap-index.xml')} />
    {apercu ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0c0a09" />
    <meta name="format-detection" content="telephone=no" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="min-h-screen bg-white font-sans text-stone-800 antialiased">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lift"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <!-- Adresse, téléphone et e-mail : volontairement en bas de page, le formulaire étant l'accès principal. -->
    <Coordonnees map={map} />
    <Footer />

    {!inlineContactForm && <ContactDialog />}
    <Lightbox />

    <script>
      import '../scripts/contact';
      import '../scripts/embeds';
    </script>
  </body>
</html>

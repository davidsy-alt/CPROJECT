---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Page introuvable | CPROJECT’" noindex>
  <PageHeader label="Erreur 404" title="Cette page est introuvable">
    <p class="mt-6 text-lg text-stone-300">
      L’adresse a peut-être changé. Retrouvez nos prestations depuis la page d’accueil.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/" class="btn btn-primary">Retour à l’accueil <Icon name="arrow-right" /></a>
      <a href="/contact/#formulaire" data-open-contact class="btn btn-ghost-light">Nous contacter</a>
    </div>
  </PageHeader>
</Layout>

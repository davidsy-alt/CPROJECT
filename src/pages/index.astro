---
import { lien } from '../data/liens';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import carte from '../assets/carte-grand-est.png';
import { partenaires, photo } from '../data/photos';
import { qcmLetters, qcmQuestions } from '../data/qcm';
import { services } from '../data/services';
import { departements, site } from '../data/site';

const atouts: { icon: IconName; label: string }[] = [
  { icon: 'file', label: 'Devis rapide et gratuit' },
  { icon: 'users', label: 'Des techniciens qualifiés' },
  { icon: 'award', label: '20 ans d’expérience' },
  { icon: 'map-pin', label: 'Interventions sur tout le Grand Est' },
];

// La première question du formulaire est posée directement sur la page d'accueil.
const [firstQuestion] = qcmQuestions;
---

<Layout title="CPROJECT’ – Flocage, protection coupe-feu, plâtrerie et isolation en Lorraine" map>
  <!-- ======= Accroche ======= -->
  <section class="relative isolate overflow-hidden bg-stone-950 text-white">
    <div class="texture-dark absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="container-page grid items-center gap-x-10 gap-y-16 pt-12 pb-44 sm:pt-16 lg:grid-cols-12 lg:pt-20 lg:pb-48">
      <div class="lg:col-span-6">
        <p class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm font-medium text-stone-200">
          <span class="size-2 shrink-0 rounded-full bg-brand-500"></span>
          Vincey (Vosges) · RGE Qualibat · agréée Placo
        </p>
        <p class="mt-6 font-display text-[clamp(2.9rem,7.2vw,5.5rem)] leading-[0.92] font-bold tracking-tight text-balance uppercase italic">
          Faites le choix de l’expertise
          <span class="whitespace-nowrap"><span class="text-brand-500">C</span>PROJECT’</span>
        </p>
        <h1 class="mt-6 max-w-xl font-sans text-lg leading-relaxed font-medium text-stone-300 sm:text-xl">
          CPROJECT’, entreprise spécialisée dans les travaux de plâtrerie, isolation, flocage fibreux et pâteux,
          protection coupe-feu, Aeroblue®, étanchéité projetée.
        </h1>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-5">
          <a href={lien('/contact/#formulaire')} data-open-contact class="btn btn-primary btn-xl">
            Demander un devis gratuit <Icon name="arrow-right" />
          </a>
          <a
            href="#prestations"
            class="inline-flex items-center gap-2 font-display text-lg font-semibold tracking-wider text-stone-200 uppercase underline decoration-white/30 decoration-2 underline-offset-8 transition hover:text-white hover:decoration-brand-500"
          >
            Nos prestations
          </a>
        </div>
      </div>

      <!-- Photos de chantier dans des cadres inclinés (rappel de l'italique du logo) -->
      <div class="relative mx-auto w-full max-w-xl lg:col-span-6 lg:max-w-none">
        <div class="absolute inset-0 translate-x-4 translate-y-4 -skew-x-[8deg] rounded-[2rem] bg-brand-600 sm:translate-x-6 sm:translate-y-6" aria-hidden="true"></div>
        <div class="relative aspect-[5/4] -skew-x-[8deg] overflow-hidden rounded-[2rem] bg-stone-800">
          <Image
            src={photo('flocage-3')}
            alt="Technicien CPROJECT’ projetant un flocage sur un mur en béton"
            widths={[480, 720, 960, 1280, 1530]}
            sizes="(min-width: 1024px) 620px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full scale-[1.22] skew-x-[8deg] object-cover"
            style="object-position: 50% 46%"
          />
        </div>
        <div class="absolute -bottom-12 -left-1 w-[34%] sm:-left-8">
          <div class="aspect-[4/5] -skew-x-[8deg] overflow-hidden rounded-2xl border-[5px] border-stone-950 bg-stone-800 shadow-lift">
            <Image
              src={photo('aeroblue-applicateur')}
              alt="Applicateur CPROJECT’ projetant l’enduit Aeroblue sur un mur en briques"
              widths={[240, 360, 480]}
              sizes="(min-width: 1024px) 220px, 34vw"
              loading="eager"
              class="h-full w-full scale-[1.3] skew-x-[8deg] object-cover"
              style="object-position: 50% 30%"
            />
          </div>
        </div>
        <div class="absolute -top-6 right-3 rounded-2xl bg-white px-5 py-4 text-stone-800 shadow-lift sm:right-6">
          <p class="font-display text-3xl leading-none font-bold tracking-tight text-stone-950 uppercase sm:text-4xl">
            Flocage
          </p>
          <p class="mt-1.5 text-sm font-medium text-stone-600">Thermique · Incendie · Acoustique</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= Contact : la première question du formulaire, au centre de la page ======= -->
  <section class="relative z-10 -mt-24 lg:-mt-28" aria-labelledby="lanceur-titre">
    <div class="container-page">
      <div class="rounded-3xl bg-white p-6 shadow-lift ring-1 ring-stone-200 sm:p-8 lg:p-10">
        <div class="grid items-center gap-x-10 gap-y-7 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="eyebrow text-brand-700">Contact</p>
            <h2 id="lanceur-titre" class="mt-3 text-4xl leading-none font-bold tracking-tight text-stone-950 sm:text-5xl">
              Votre projet en {qcmQuestions.length} questions
            </h2>
            <p class="mt-3 text-stone-600">
              Cochez vos réponses, laissez vos coordonnées : nous vous rappelons sur le créneau de votre choix.
            </p>
          </div>

          <div class="lg:col-span-8">
            <p class="flex items-center gap-3 font-display text-2xl leading-none font-bold text-stone-950 sm:text-3xl">
              <span class="q-badge"><span>Q1</span></span>
              {firstQuestion.title}
            </p>
            <ul class="mt-4 grid gap-3 sm:grid-cols-3">
              {
                firstQuestion.options.map((option, i) => (
                  <li>
                    <a
                      href={lien('/contact/#formulaire')}
                      data-open-contact
                      data-preset-question={firstQuestion.id}
                      data-preset-option={i}
                      data-preset-advance
                      class="group flex h-full items-center gap-4 rounded-2xl border-2 border-stone-200 bg-white p-4 transition duration-150 hover:border-brand-600 hover:bg-brand-50 sm:flex-col sm:items-start sm:gap-3"
                    >
                      <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-stone-100 font-display text-2xl font-bold text-stone-700 transition duration-150 group-hover:bg-brand-600 group-hover:text-white">
                        {qcmLetters[i]}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block text-lg leading-snug font-semibold text-stone-950">{option.label}</span>
                        {option.detail && <span class="mt-1 block text-sm leading-snug text-stone-500">{option.detail}</span>}
                      </span>
                      <Icon
                        name="arrow-right"
                        class="size-5 shrink-0 text-stone-300 transition duration-150 group-hover:translate-x-1 group-hover:text-brand-600 sm:hidden"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= Atouts ======= -->
  <section aria-label="Nos atouts">
    <ul class="container-page grid grid-cols-2 gap-x-6 gap-y-6 py-12 lg:grid-cols-4 lg:py-14">
      {
        atouts.map((atout) => (
          <li class="flex items-center gap-3.5">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={atout.icon} />
            </span>
            <span class="font-display text-lg leading-tight font-semibold tracking-wide text-stone-950 uppercase sm:text-xl">
              {atout.label}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ======= Prestations ======= -->
  <section id="prestations" class="scroll-mt-24 border-t border-stone-200 py-20 lg:py-28">
    <div class="container-page">
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-5">
          <p class="eyebrow text-brand-700">Nos prestations</p>
          <h2 class="title-section mt-4">Travaux de plâtrerie, plâtre projeté, flocage et isolation</h2>
        </div>
        <p class="text-lg text-stone-600 lg:col-span-7">
          Installée idéalement à <strong class="font-semibold text-stone-900">Vincey</strong> dans les
          <strong class="font-semibold text-stone-900">Vosges</strong> sur l’axe
          <strong class="font-semibold text-stone-900">Épinal-Nancy</strong>, l’entreprise
          <strong class="font-semibold text-stone-900">CPROJECT’</strong> propose depuis plus de 15 ans ses services et
          savoir-faire aux <strong class="font-semibold text-stone-900">professionnels</strong> comme aux
          <strong class="font-semibold text-stone-900">particuliers</strong> pour tous
          <strong class="font-semibold text-stone-900"
            >travaux de plâtrerie, plâtre projeté, flocage et plâtrerie isolation</strong
          >.
        </p>
      </div>

      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">
        {
          services.map((service, i) => (
            <li>
              <ServiceCard service={service} index={i + 1} />
            </li>
          ))
        }
      </ul>

      <!-- Documentation -->
      <div class="mt-8 flex flex-col gap-6 rounded-2xl bg-stone-100 p-7 ring-1 ring-stone-200 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="flex items-center gap-5">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-stone-950 text-white">
            <Icon name="file" class="size-6" />
          </span>
          <div>
            <h3 class="text-2xl font-bold tracking-wide text-stone-950 uppercase sm:text-3xl">Documentation</h3>
            <p class="mt-1 text-stone-600">Téléchargez notre documentation au format PDF.</p>
          </div>
        </div>
        <a href={lien('/DOCUMENTATION.pdf')} target="_blank" rel="noopener" class="btn btn-dark shrink-0">
          <Icon name="download" /> Télécharger
        </a>
      </div>
    </div>
  </section>

  <!-- ======= Localisation ======= -->
  <section class="texture-light border-y border-stone-200 bg-stone-100 py-20 lg:py-28">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow text-brand-700">Localisation</p>
        <h2 class="title-section mt-4">Nos équipes de professionnels interviennent sur tout le Grand Est</h2>
        <ul class="mt-9 flex flex-wrap gap-2.5">
          {
            departements.map((departement) => (
              <li class="inline-flex items-center gap-2.5 rounded-full bg-white py-1.5 pr-1.5 pl-4 font-medium text-stone-800 shadow-card ring-1 ring-stone-200">
                {departement.name}
                <span class="rounded-full bg-stone-950 px-2.5 py-0.5 font-display text-base font-semibold tracking-wide text-white">
                  {departement.code}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <Image
        src={carte}
        alt="Carte des départements du Grand Est où intervient CPROJECT’"
        widths={[480, 720, 918]}
        sizes="(min-width: 1024px) 560px, 100vw"
        class="mx-auto h-auto w-full max-w-xl drop-shadow-xl"
      />
    </div>
  </section>

  <!-- ======= Partenaires ======= -->
  <section class="py-20 lg:py-24">
    <div class="container-page">
      <div class="flex flex-col items-center text-center">
        <p class="eyebrow text-brand-700">Partenaires</p>
        <h2 class="title-section mt-4">Labels et partenaires</h2>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
        {
          Object.values(partenaires).map((partenaire) => (
            <li class="flex aspect-[4/3] items-center justify-center rounded-2xl bg-white p-4 shadow-card ring-1 ring-stone-200 lg:aspect-square">
              <Image src={partenaire.logo} alt={partenaire.name} width={200} class="h-full w-full object-contain" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand items={[...site.reassurance, site.reassuranceZone]} />
</Layout>

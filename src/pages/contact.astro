---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import QcmForm from '../components/QcmForm.astro';
import { qcmQuestions } from '../data/qcm';
import { site } from '../data/site';

const etapes = [
  { title: `Répondez à ${qcmQuestions.length} questions`, text: 'Votre besoin, votre délai : il suffit de cocher.' },
  { title: 'Choisissez votre créneau de rappel', text: 'En fin de matinée ou en fin de journée, du lundi au vendredi.' },
  { title: 'Nous vous rappelons', text: 'Pour étudier votre projet et préparer votre devis, rapide et gratuit.' },
];
---

<!--
  Le formulaire occupe le haut de la page ; les coordonnées (adresse, téléphone, e-mail) et la carte
  sont affichées en bas, dans le bloc « Nos coordonnées » commun à tout le site.
-->
<Layout title="Contact et demande d’étude personnalisée | CPROJECT’" inlineContactForm map>
  <PageHeader label="Contact" title="CPROJECT’ : contact et demande d’étude personnalisée" />

  <section class="texture-light bg-stone-100 py-14 lg:py-20">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Formulaire QCM -->
      <div id="formulaire" class="scroll-mt-28 overflow-hidden rounded-3xl bg-white shadow-card ring-1 ring-stone-200 lg:col-span-7">
        <div class="border-b border-stone-200 px-6 py-6 sm:px-9">
          <p class="eyebrow text-brand-700">Devis gratuit</p>
          <h2 class="mt-2 text-4xl font-bold tracking-tight text-stone-950 sm:text-5xl">Parlons de votre projet</h2>
          <p class="mt-2 text-stone-600">
            {qcmQuestions.length} questions, puis vos coordonnées : nous vous rappelons sur le créneau de votre choix.
          </p>
        </div>
        <div class="px-6 pt-7 pb-6 sm:px-9">
          <QcmForm idPrefix="page" />
        </div>
      </div>

      <div class="space-y-6 lg:col-span-5">
        <!-- Déroulé -->
        <div class="rounded-3xl bg-white p-7 shadow-card ring-1 ring-stone-200 sm:p-9">
          <h2 class="text-3xl font-bold tracking-tight text-stone-950 sm:text-4xl">Comment ça se passe ?</h2>
          <ol class="mt-7 space-y-6">
            {
              etapes.map((etape, i) => (
                <li class="flex gap-4">
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-stone-950 font-display text-xl font-bold text-white">
                    {i + 1}
                  </span>
                  <span>
                    <span class="block text-lg leading-snug font-semibold text-stone-950">{etape.title}</span>
                    <span class="mt-0.5 block text-stone-600">{etape.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <ul class="mt-8 space-y-2.5 border-t border-stone-200 pt-7 font-medium text-stone-800">
            {
              [...site.reassurance, site.reassuranceZone].map((item) => (
                <li class="flex items-center gap-3">
                  <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white">
                    <Icon name="check" class="size-3.5" />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Avis Google -->
        <a
          href={site.googleReviewUrl}
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-5 rounded-3xl bg-white p-6 shadow-card ring-1 ring-stone-200 transition hover:ring-stone-400 sm:px-9"
        >
          <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-600">
            <Icon name="star" class="size-6 fill-current" />
          </span>
          <span class="flex-1">
            <span class="block font-display text-2xl leading-tight font-bold tracking-wide text-stone-950 uppercase">
              Avis clients Google
            </span>
            <span class="block text-sm text-stone-600">Donnez votre avis sur {site.name}</span>
          </span>
          <Icon name="external" class="size-5 shrink-0 text-stone-400 transition group-hover:text-stone-900" />
        </a>
      </div>
    </div>

    <p class="container-page mt-10 text-center text-sm text-stone-600">
      CPROJECT : flocage fibreux, flocage pâteux, Aeroblue, plâtre projeté, protection coupe-feu, isolation plâtrerie dans
      le Grand Est
    </p>
  </section>
</Layout>

# Copier en `.env` et renseigner. Les variables PUBLIC_* sont intégrées au site au build.

# URL qui reçoit les demandes du formulaire de contact et crée le rendez-vous (POST JSON) :
# webhook n8n, Make, Zapier, API maison…
# Laisser vide tant que rien n'est branché : le formulaire ouvre alors un e-mail pré-rempli
# vers l'adresse de contact définie dans src/data/site.ts.
PUBLIC_CONTACT_WEBHOOK_URL=

# URL qui indique les créneaux d'appel déjà pris (GET JSON), pour les griser dans le formulaire.
# Elle reçoit ?debut=<ISO>&fin=<ISO> et répond { "occupes": [{ "debut": "…", "fin": "…" }] }.
# Laisser vide tant que rien n'est branché : tous les créneaux sont alors proposés.
PUBLIC_CRENEAUX_URL=

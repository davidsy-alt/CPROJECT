# Copier en `.env` et renseigner. Les variables PUBLIC_* sont intégrées au site au build.

# URL qui reçoit les demandes du formulaire de contact (POST JSON) : webhook n8n, Make, Zapier, API maison…
# Laisser vide tant que rien n'est branché : le formulaire ouvre alors un e-mail pré-rempli
# vers l'adresse de contact définie dans src/data/site.ts.
PUBLIC_CONTACT_WEBHOOK_URL=
